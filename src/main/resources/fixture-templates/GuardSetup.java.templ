package io.github.wrinfotel.fixture;

import org.junit.jupiter.api.Test;

/**
 * Sets the "{{KEY}}" system property in a static initializer: the class is loaded during
 * discovery of a probe/run, so the property is already set before any test executes.
 * Models the hidden dependency "some other test prepared the environment".
 */
public class {{NAME}} {

    static {
        System.setProperty("{{KEY}}", "set-by-{{NAME}}");
    }

    @Test
    void setup() {
    }
}
