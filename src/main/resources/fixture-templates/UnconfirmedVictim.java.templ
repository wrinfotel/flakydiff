package io.github.wrinfotel.fixture;

import org.junit.jupiter.api.Test;

import java.util.concurrent.atomic.AtomicInteger;

/**
 * Victim with a boundary count for confirmation (spec §5 case 10): under pollution
 * of the "{{KEY}}" key it fails on runs 2–4 — with probe repeat=3 that gives 2/3 failed
 * (ddmin reproduces), with confirmation repeat=5 exactly 3/5 failed (<4 →
 * UNCONFIRMED). A clean JVM — all repeats pass. The counter lives for one probe JVM
 * and is not carried across probes. Models a victim with a limited "flake window".
 */
public class {{NAME}} {

    private static final AtomicInteger RUNS = new AtomicInteger();

    @Test
    void shouldWork() {
        if (PollutionState.isPolluted("{{KEY}}")) {
            int n = RUNS.incrementAndGet();
            if (n >= 2 && n <= 4) {
                throw new AssertionError("polluted victim run " + n);
            }
        }
    }
}
